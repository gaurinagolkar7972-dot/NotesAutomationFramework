<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Notes Automation Suite">

    <test name="UI Tests">
        <classes>
            <class name="tests.ui.LoginTest"/>
            <class name="tests.negative.InvalidLoginTest"/>
            <class name="tests.negative.EmptyFieldTest"/>
            <class name="tests.ui.CreateNoteTest"/>
            <class name="tests.ui.DeleteNoteTest"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="tests.api.LoginApiTest"/>
            <class name="tests.api.InvalidLoginApiTest"/>
            <class name="tests.api.CreateNoteApiTest"/>
            <class name="tests.api.GetNotesTest"/>
            <class name="tests.api.DeleteNoteApiTest"/>
            <class name="tests.api.UnauthorizedApiTest"/>
        </classes>
    </test>

</suite>