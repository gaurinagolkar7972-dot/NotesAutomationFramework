<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

    <suite name="NotesAutomationParallelSuite"
       parallel="none">

    <listeners>
        <listener class-name="com.expandtesting.notes.utils.TestListener"/>
    </listeners>

    <test name="API Tests">
        <classes>
            <class name="com.expandtesting.notes.tests.api.GetNotesApiTest"/>
            <class name="com.expandtesting.notes.tests.api.CreateNoteApiTest"/>
            <class name="com.expandtesting.notes.tests.api.DeleteNoteApiTest"/>
            <class name="com.expandtesting.notes.tests.api.GetSingleNoteApiTest"/>
            <class name="com.expandtesting.notes.tests.api.NegativeApiTest"/>
            <class name="com.expandtesting.notes.tests.api.UpdateNoteApiTest"/>
            <class name="com.expandtesting.notes.tests.api.CreateNoteWithoutTokenTest"/>
            <class name="com.expandtesting.notes.tests.api.GetInvalidNoteApiTest"/>
            <class name="com.expandtesting.notes.tests.api.GetNotesWithoutTokenTest"/>
        </classes>
    </test>

    <test name="UI Tests">
        <classes>
            <class name="com.expandtesting.notes.tests.ui.LoginTest"/>
            <class name="com.expandtesting.notes.tests.ui.LogoutTest"/>
            <class name="com.expandtesting.notes.tests.ui.NegativeLoginTest"/>
            <class name="com.expandtesting.notes.tests.ui.DeleteNoteUITest"/>
            <class name="com.expandtesting.notes.tests.ui.CreateNoteUITest"/>
        </classes>
    </test>

    <test name="Hybrid E2E Tests">
        <classes>
            <class name="com.expandtesting.notes.tests.e2e.UiToApiValidationTest"/>
            <class name="com.expandtesting.notes.tests.e2e.ApiToUiValidationTest"/>
            <class name="com.expandtesting.notes.tests.e2e.ApiDeleteReflectsInUITest"/>
        </classes>
    </test>

</suite>